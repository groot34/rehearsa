# ==============================================================================
# Rehearsa — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration (for Next.js apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# CORS — allow the Next.js dev server to reach the API
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Persistence — MongoDB (Milestone 8)
# ---------------------------------------------------------------------------
# For local development: install MongoDB Community Edition and use the URI below.
# For cloud: sign up for a free MongoDB Atlas M0 cluster and paste the URI here.
# The server will NOT start in production unless this is set.
MONGODB_URI=mongodb://localhost:27017/rehearsa

# ---------------------------------------------------------------------------
# Authentication — JWT (Milestone 8)
# ---------------------------------------------------------------------------
# REQUIRED: Generate a secure random string (minimum 32 characters).
# Example (run once):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will log a warning in development and refuse to start in production
# if this value is missing or shorter than 32 characters.
JWT_SECRET=change_this_to_a_secure_random_string_minimum_32_characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------
# Supported providers: gemini, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Per-request timeout (ms) for Gemini generateContent calls.
# Increase if you see "timeout of N ms exceeded" on Render free tier with large prompts.
# Default: 60000 (60 seconds). Minimum accepted: 1000.
GEMINI_TIMEOUT_MS=60000

# Groq (Alternative free-tier / fast inference)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# ---------------------------------------------------------------------------
# Public Interview Discussion Search (Optional)
# ---------------------------------------------------------------------------
# Supported providers: tavily (intended production), google (historical/alternative), mock (default)
# Tavily Search API: sign up at https://tavily.com for an API key
# Mock provider is used by default if credentials are not configured
INTERVIEW_SEARCH_PROVIDER=mock
# TAVILY_API_KEY=tvly-your_tavily_api_key_here
# GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
# GOOGLE_SEARCH_CX=your_google_custom_search_engine_id

# ---------------------------------------------------------------------------
# Web Crawling & Research Security
# ---------------------------------------------------------------------------
CRAWL_MAX_PAGES_PER_SITE=5
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BODY_SIZE_BYTES=2097152
ALLOW_LOOPBACK_IN_DEV=true
