# ==============================================================================
# Rehearsa — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration (for Next.js apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Persistence (MongoDB) [Planned for Milestone 3]
# MONGODB_URI=mongodb://localhost:27017/rehearsa

# Authentication Secrets [Planned for Milestone 3]
# JWT_SECRET=change_this_to_a_secure_random_string_in_production
# JWT_EXPIRES_IN=7d

# LLM Provider Configuration [Planned for Milestone 3]
# Supported providers: gemini, groq, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq (Alternative free-tier / fast inference)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# Web Crawling & Research Security
CRAWL_MAX_PAGES_PER_SITE=5
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BODY_SIZE_BYTES=2097152 # 2MB
ALLOW_LOOPBACK_IN_DEV=true
